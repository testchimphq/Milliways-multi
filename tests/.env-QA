# Environment variables for QA
# One variable per line: KEY=value
# Use in your Playwright scripts via process.env.KEY
# Example:
# BASE_URL=https://qa.example.com
# USERNAME=test_user_qa
# Web UI (Playwright): local Angular dev server; proxies /auth, /menu, /qa to backend.
BASE_URL=http://localhost:4200
# Seed/teardown API (fixtures): Docker backend per ai-test-instructions.
MILLIWAYS_API_BASE_URL=http://localhost:3001
